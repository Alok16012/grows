{
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "regions": [
    "hnd1"
  ],
  "functions": {
    "app/api/**": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-leave-status",
      "schedule": "45 18 * * *"
    },
    {
      "path": "/api/cron/inspection-daily",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/dwm-daily",
      "schedule": "35 3 * * *"
    },
    {
      "path": "/api/cron/lms-daily",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/cron/expense-daily",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron/asset-daily",
      "schedule": "50 3 * * *"
    }
  ]
}
